{
  "name": "wayward-house",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Wayward House — hub site. Long-form writing on place, systems, and the geography of the modern economy.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "wrangler pages dev ./dist",
    "astro": "astro",
    "deploy": "npm run build && wrangler pages deploy ./dist --project-name=wayward-house",
    "postbuild:og": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.2.1",
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/rss": "^4.0.7",
    "@astrojs/sitemap": "^3.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^6.1.9",
    "gray-matter": "^4.0.3",
    "satori": "^0.12.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "pagefind": "^1.1.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.85.0"
  }
}
