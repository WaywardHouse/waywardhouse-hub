---
import Layout from '@layouts/Layout.astro';
---
<Layout title="Terms of Use" description="Basic terms covering use of the site and the limits of the analysis published here." active={undefined}>
  <section class="wh-wrap wh-section">
    <header class="wh-page-header">
      <span class="wh-kicker">Terms · Last updated 31 Mar 2026</span>
      <h1>Terms of Use</h1>
      <p class="wh-dek">Basic terms covering use of the site, its original material, and the limits of the analysis and models published here.</p>
    </header>

    <div class="wh-prose">
      <h2>Content</h2>
      <p>All original writing, analysis, and maps on this site are the work of the author unless otherwise noted. Posts may be shared with attribution and a link back to the original URL.</p>

      <h2>Models and Analysis</h2>
      <p>Quantitative analysis on this site is provided for informational and educational purposes. Results should be verified independently before being used for any specific application.</p>

      <h2>External Links</h2>
      <p>Links to external sites are included for context. No endorsement is implied.</p>

      <h2>Changes</h2>
      <p>These terms may be updated at any time.</p>
    </div>
  </section>
</Layout>
