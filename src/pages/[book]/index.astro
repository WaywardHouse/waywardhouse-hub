---
import Layout from '@layouts/Layout.astro';
import WhImage from '@components/WhImage.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map((b) => ({ params: { book: b.data.slug }, props: { book: b.data } }));
}
const { book } = Astro.props;
---
<Layout title={book.title} description={book.description}>
  <section class="wh-book-front">
    <div class="wh-book-front__cover">
      {book.cover.mode === 'photo' && book.cover.image
        ? <WhImage id={book.cover.image} treatment="duotone" ratio="3/4" loading="eager" />
        : <div class="wh-book-front__type" style={`--cover: ${book.cover.color}`}><span class="wh-book-cover__n">{book.n}</span><span class="wh-book-cover__title">{book.title}</span></div>
      }
    </div>
    <div class="wh-book-front__meta wh-wrap">
      <span class="wh-kicker">Book {book.n} · {book.statusLabel}</span>
      <h1>{book.title}</h1>
      <p class="wh-dek">{book.description}</p>
      <div class="wh-book-front__cta">
        <a class="wh-btn wh-btn--primary" href={`/${book.slug}/ch1/`}>Start reading →</a>
        {book.pdfUrl && <a class="wh-btn wh-btn--ghost" href={book.pdfUrl}>Download PDF</a>}
        <a class="wh-btn wh-btn--ghost" href={`https://github.com/${book.repo}`}>View on GitHub</a>
      </div>
    </div>
  </section>

  {book.chapters.length > 0 && (
    <section class="wh-wrap wh-section wh-toc">
      <h2 class="wh-kicker">Contents</h2>
      <ol class="wh-toc__list">
        {book.chapters.map((c) => (
          <li>
            <a href={`/${book.slug}/ch${c.n}/`}>
              <span class="wh-toc__n">{c.n}</span>
              <span>
                {c.part && <span class="wh-toc__part">{c.part}</span>}
                <strong>{c.title}</strong>
              </span>
            </a>
          </li>
        ))}
      </ol>
      <p class="wh-toc__note">This book is a Quarto project. The web edition above is the rendered Quarto output, deployed separately and routed under <code>/{book.slug}/</code>. The hub does not own the chapter HTML.</p>
    </section>
  )}
</Layout>
