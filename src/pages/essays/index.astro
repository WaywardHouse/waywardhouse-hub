---
import Layout from '@layouts/Layout.astro';
import SectionHead from '@components/SectionHead.astro';
import WhImage from '@components/WhImage.astro';
import { getCollection } from 'astro:content';

const essays = (await getCollection('essays', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const fmtDate = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---
<Layout title="Essays" active="essays" description="Long-form essays on place, economy, and environment.">
  <section class="wh-wrap wh-section">
    <header class="wh-page-header">
      <span class="wh-kicker">Index · Essays</span>
      <h1>Essays</h1>
      <p class="wh-dek">Long-form writing on the geography of the modern economy. Each essay is built to be re-read, not skimmed.</p>
    </header>

    <ul class="wh-essay-list">
      {essays.map((e) => (
        <li class="wh-essay-row">
          <a class="wh-essay-row__img" href={`/essays/${e.id}/`}>
            <WhImage id={e.data.heroImage ?? 'geo-04'} treatment={e.data.heroTreatment ?? 'warm'} ratio="3/2" />
          </a>
          <div class="wh-essay-row__body">
            <span class="wh-kicker">{e.data.topic} · {e.data.readTime} min · {fmtDate(e.data.pubDate)}</span>
            <h2><a href={`/essays/${e.id}/`}>{e.data.title}</a></h2>
            {e.data.dek && <p>{e.data.dek}</p>}
            <div class="wh-essay-row__topics">
              {e.data.topics.map((t) => <a class="wh-chip wh-chip--sm" href={`/topics/${t.toLowerCase().replace(/[^a-z0-9]+/g,'-')}/`}>{t}</a>)}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Layout>
