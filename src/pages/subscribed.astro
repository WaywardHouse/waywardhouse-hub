---
import Layout from '@layouts/Layout.astro';
---
<Layout title="You're subscribed" description="Your Wayward House subscription is confirmed.">
  <section class="wh-wrap wh-section wh-confirmation">
    <div class="wh-confirmation__inner">
      <span class="wh-kicker wh-kicker--red">Confirmed</span>
      <h1>You're in.</h1>
      <p class="wh-dek">You'll receive System Signals plus a note when new long-form essays publish. If the confirmation didn't arrive, check Promotions or spam and mark it safe.</p>
      <div class="wh-confirmation__actions">
        <a href="/signals/" class="wh-btn wh-btn--red">Read System Signals →</a>
        <a href="/essays/" class="wh-btn wh-btn--outline">Browse essays</a>
      </div>
    </div>
  </section>
</Layout>
