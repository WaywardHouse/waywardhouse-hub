---
import Layout from '@layouts/Layout.astro';
import WhImage from '@components/WhImage.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const issues = await getCollection('signals', ({ data }) => !data.draft);
  return issues.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const fmtDate = (x: Date) => x.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<Layout title={`№ ${String(d.issue).padStart(3,'0')} — ${d.title}`} active="signals" readingProgress>
  <article class="wh-read wh-signal">
    <header class="wh-wrap wh-signal__header">
      <span class="wh-kicker wh-kicker--amber">System Signals · Issue {String(d.issue).padStart(3,'0')}</span>
      <h1>{d.title}</h1>
      <p class="wh-dek">{d.summary}</p>
      <div class="wh-read__meta"><span>{d.topic}</span><span>·</span><span>{fmtDate(d.pubDate)}</span></div>
    </header>
    {d.heroImage && (
      <div class="wh-wrap wh-signal__img"><WhImage id={d.heroImage} treatment="caption-bar" ratio="21/9" issue={`Issue ${String(d.issue).padStart(3,'0')}`} /></div>
    )}
    <div class="wh-wrap wh-read__body wh-read__body--single">
      <div class="wh-read__prose">
        <Content />
        {d.bullets.length > 0 && (
          <section>
            <h2>The signal</h2>
            <ul>{d.bullets.map((b) => <li>{b}</li>)}</ul>
          </section>
        )}
        {d.sources.length > 0 && (
          <section class="wh-sources">
            <span class="wh-kicker">Sources</span>
            <ol>{d.sources.map((s) => <li>{s}</li>)}</ol>
          </section>
        )}
      </div>
    </div>
  </article>
</Layout>
