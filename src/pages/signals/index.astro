---
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';

const issues = (await getCollection('signals', ({ data }) => !data.draft))
  .sort((a, b) => b.data.issue - a.data.issue);

const fmtDate = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---
<Layout title="System Signals" active="signals" description="Weekly digest of energy, infrastructure, and spatial systems in motion.">
  <section class="wh-wrap wh-section">
    <header class="wh-page-header">
      <span class="wh-kicker wh-kicker--amber">Newsletter · Weekly</span>
      <h1>System Signals</h1>
      <p class="wh-dek">A short brief on energy, infrastructure, and spatial systems — what's moving, what it means. Free, weekly, no chatter.</p>
    </header>
    <div id="subscribe" class="wh-subscribe">
      <div class="wh-subscribe__copy">
        <span class="wh-kicker wh-kicker--amber">Subscribe</span>
        <h2>One issue a week. No tracking.</h2>
        <p>Plain-text email, no algorithmic inbox tricks. Unsubscribe with one click.</p>
      </div>
      <form class="wh-subscribe__form" id="signals-sub-form" novalidate>
        <input type="hidden" name="source" value="signals-page" />
        <input type="email" name="email" placeholder="you@domain" required />
        <button type="submit" class="wh-btn wh-btn--amber">Subscribe →</button>
        <p class="wh-subscribe__status" id="signals-sub-status" role="status" aria-live="polite"></p>
      </form>
    </div>

    <ol class="wh-signal-list">
      {issues.map((s) => (
        <li class="wh-signal-row">
          <a href={`/signals/${s.id}/`}>
            <div class="wh-signal-row__n">№ {String(s.data.issue).padStart(3, '0')}</div>
            <div class="wh-signal-row__body">
              <span class="wh-kicker">{s.data.topic} · {fmtDate(s.data.pubDate)}</span>
              <h2>{s.data.title}</h2>
              <p>{s.data.summary}</p>
            </div>
            <div class="wh-signal-row__arrow">→</div>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Layout>

<script>
(function () {
  const form   = document.getElementById('signals-sub-form');
  const status = document.getElementById('signals-sub-status');
  const submit = form?.querySelector('button[type="submit"]');
  if (!form || !status || !submit) return;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (form.querySelector('input[name="email"]')?.value || '').trim();
    if (!email) return;

    const orig         = submit.textContent;
    submit.disabled    = true;
    submit.textContent = 'Subscribing…';
    status.textContent = '';

    try {
      const res  = await fetch('/api/subscribe', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ email, source: 'signals-page' }),
      });
      const data = await res.json().catch(() => ({}));

      if (res.ok) {
        if (data.message === 'already_subscribed') {
          status.textContent  = "Already subscribed — check your inbox.";
          status.dataset.tone = 'success';
          submit.textContent  = orig;
          submit.disabled     = false;
        } else {
          status.textContent  = 'Check your inbox for the confirmation email.';
          status.dataset.tone = 'success';
          form.querySelector('input[name="email"]').value = '';
          submit.textContent = 'Sent ✓';
        }
      } else {
        status.textContent  = data.error || 'Something went wrong. Please try again.';
        status.dataset.tone = 'error';
        submit.textContent  = orig;
        submit.disabled     = false;
      }
    } catch {
      status.textContent  = 'Network error. Please try again.';
      status.dataset.tone = 'error';
      submit.textContent  = orig;
      submit.disabled     = false;
    }
  });
})();
</script>
