---
import Layout from '@layouts/Layout.astro';
---
<Layout title="Ask Pepper" description="Ask Pepper — a blind Labrador Retriever-Augmented Generation model who navigates the Wayward House archive entirely by smell. Geography questions answered from the essays and signals. Your mileage may vary.">
  <section class="wh-wrap wh-section">
    <header class="wh-page-header wh-pepper-header">
      <div class="wh-pepper-id">
        <div class="wh-pepper-badge">
          <img src="/pepper.jpg" alt="Pepper the Labrador" class="wh-pepper-photo" />
        </div>
        <div>
          <span class="wh-kicker">Archive assistant</span>
          <h1>Ask Pepper - the Retriever-Augmented Generator</h1>
        </div>
      </div>
      <p class="wh-dek">Pepper is a blind Labrador who navigates the Wayward House archive entirely by smell. She knows Alberta economics, energy geography, trade, and the environment — anything covered in the essays, signals or cimputational geography. Outside the archive, her nose goes quiet and she'll tell you so. Like any true retriever, she is occasionally forced to nap.</p>
    </header>

    <div class="wh-ask">
      <form class="wh-ask__form" id="ask-form" novalidate>
        <div class="wh-ask__input-row">
          <input
            type="text"
            id="ask-input"
            class="wh-ask__input"
            placeholder="Ask Pepper a geography question…"
            autocomplete="off"
            maxlength="500"
          />
          <button type="submit" class="wh-btn wh-btn--red" id="ask-submit">Ask →</button>
        </div>
      </form>

      <div class="wh-ask__response" id="ask-response" hidden>
        <div class="wh-ask__byline">
          <span class="wh-pepper-inline" aria-hidden="true">🐾</span>
          <span class="wh-kicker">Pepper</span>
        </div>
        <div class="wh-ask__answer" id="ask-answer"></div>
        <div class="wh-ask__sources" id="ask-sources" hidden>
          <span class="wh-kicker">From the archive</span>
          <ul id="ask-sources-list"></ul>
        </div>
      </div>

      <div class="wh-ask__examples" id="ask-examples">
        <span class="wh-kicker">Things Pepper knows well</span>
        <ul class="wh-ask__example-list">
          <li><button class="wh-ask__example" type="button">Why did the Fort McMurray fire spread so fast into the city?</button></li>
          <li><button class="wh-ask__example" type="button">What is the wildland-urban interface and why does it matter for Alberta?</button></li>
          <li><button class="wh-ask__example" type="button">How does Alberta's landlocked geography affect oil prices?</button></li>
          <li><button class="wh-ask__example" type="button">What is the rockets and feathers problem at the pump?</button></li>
          <li><button class="wh-ask__example" type="button">How exposed is Alberta to US tariffs?</button></li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
.wh-pepper-header { padding-bottom: 0; }

.wh-pepper-id {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  margin-bottom: 1rem;
}

.wh-pepper-badge {
  width: 56px;
  height: 56px;
  flex-shrink: 0;
  overflow: hidden;
}

.wh-pepper-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.wh-pepper-id h1 { margin: 0; }
.wh-pepper-id .wh-kicker { display: block; margin-bottom: 0.25rem; }

.wh-ask { max-width: 680px; margin-top: 2rem; }

.wh-ask__form { margin-bottom: 2rem; }

.wh-ask__input-row {
  display: flex;
  gap: 0.75rem;
}

.wh-ask__input {
  flex: 1;
  padding: 0.75rem 1rem;
  font-family: var(--wh-ff-body);
  font-size: 1rem;
  border: 1px solid var(--wh-rule);
  background: var(--wh-paper);
  color: var(--wh-dark);
  outline: none;
}
.wh-ask__input:focus { border-color: var(--wh-red); }

.wh-ask__response {
  margin-bottom: 2.5rem;
  padding: 1.25rem 1.5rem;
  border-left: 3px solid var(--wh-dark);
  background: var(--wh-paper);
}

.wh-ask__byline {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.875rem;
}
.wh-pepper-inline { font-size: 0.875rem; }

.wh-ask__answer {
  font-family: var(--wh-ff-read);
  font-size: 1rem;
  line-height: 1.75;
  color: var(--wh-dark);
  white-space: pre-wrap;
}

.wh-ask__answer.is-loading::after {
  content: '▋';
  animation: blink 0.8s step-end infinite;
}
@keyframes blink { 50% { opacity: 0; } }

.wh-ask__sources {
  margin-top: 1.25rem;
  padding-top: 1rem;
  border-top: 1px solid var(--wh-rule);
}
.wh-ask__sources ul { list-style: none; padding: 0; margin: 0.5rem 0 0; }
.wh-ask__sources li { margin-bottom: 0.35rem; }
.wh-ask__sources a { color: var(--wh-dark); font-size: 0.875rem; }
.wh-ask__sources a:hover { color: var(--wh-red); }

.wh-ask__examples { margin-top: 0.5rem; }
.wh-ask__example-list {
  list-style: none;
  padding: 0;
  margin: 0.75rem 0 0;
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}
.wh-ask__example {
  padding: 0.4rem 0.875rem;
  border: 1px solid var(--wh-rule);
  background: none;
  font-family: var(--wh-ff-body);
  font-size: 0.8125rem;
  color: var(--wh-mid);
  cursor: pointer;
  text-align: left;
  transition: border-color 0.15s, color 0.15s;
}
.wh-ask__example:hover { border-color: var(--wh-dark); color: var(--wh-dark); }
</style>

<script is:inline>
(function () {
  const form     = document.getElementById('ask-form');
  const input    = document.getElementById('ask-input');
  const submit   = document.getElementById('ask-submit');
  const resp     = document.getElementById('ask-response');
  const answer   = document.getElementById('ask-answer');
  const sources  = document.getElementById('ask-sources');
  const srcList  = document.getElementById('ask-sources-list');
  const examples = document.getElementById('ask-examples');

  async function ask(question) {
    if (!question.trim()) return;

    resp.hidden    = false;
    sources.hidden = true;
    srcList.innerHTML  = '';
    answer.textContent = '';
    answer.classList.add('is-loading');
    submit.disabled    = true;
    submit.textContent = 'Sniffing…';
    if (examples) examples.hidden = true;

    try {
      const res = await fetch('/api/ask', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ question }),
      });

      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        answer.classList.remove('is-loading');
        answer.textContent = data.error || 'Something went wrong. Please try again.';
        return;
      }

      const reader  = res.body.getReader();
      const decoder = new TextDecoder();
      let   buffer  = '';
      let   text    = '';

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop();

        for (const line of lines) {
          if (!line.startsWith('data: ')) continue;
          const data = line.slice(6);
          if (data === '[DONE]') continue;

          try {
            const parsed = JSON.parse(data);

            if (parsed.sources) {
              if (parsed.sources.length > 0) {
                srcList.innerHTML = parsed.sources
                  .map(s => `<li><a href="${s.url}">${s.title}</a></li>`)
                  .join('');
                sources.hidden = false;
              }
              continue;
            }

            const token = parsed.response ?? parsed.choices?.[0]?.delta?.content ?? '';
            text += token;
            answer.textContent = text;
          } catch { /* skip */ }
        }
      }
    } catch {
      answer.textContent = "Pepper's nose twitched but nothing came through. Try again.";
    } finally {
      answer.classList.remove('is-loading');
      submit.disabled    = false;
      submit.textContent = 'Ask →';
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    ask(input.value);
  });

  document.querySelectorAll('.wh-ask__example').forEach(btn => {
    btn.addEventListener('click', () => {
      input.value = btn.textContent;
      ask(btn.textContent);
    });
  });

  // Pre-fill from ?q= URL parameter (linked from FAB panels on book pages)
  const qParam = new URLSearchParams(window.location.search).get('q');
  if (qParam) {
    input.value = qParam;
    ask(qParam);
  }
})();
</script>
