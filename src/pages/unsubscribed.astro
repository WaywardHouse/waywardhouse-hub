---
import Layout from '@layouts/Layout.astro';
---
<Layout title="Unsubscribed" description="You've been removed from the Wayward House mailing list.">
  <section class="wh-wrap wh-section wh-confirmation">
    <div class="wh-confirmation__inner">
      <span class="wh-kicker">Unsubscribed</span>
      <h1>You're unsubscribed.</h1>
      <p class="wh-dek">No more emails from Wayward House. No further action needed.</p>
      <p>Changed your mind? <a href="/subscribe/" class="wh-link">Resubscribe →</a></p>
      <div class="wh-confirmation__actions">
        <a href="/essays/" class="wh-btn wh-btn--outline">Browse essays</a>
      </div>
    </div>
  </section>
</Layout>
