---
import '@/styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import type { NavKey } from '@lib/tokens';

interface Props {
  title: string;
  description?: string;
  active?: NavKey;
  ogImage?: string;
  bodyClass?: string;
  /** Optional book second-tier nav (see Header.astro) */
  book?: Parameters<typeof Header>[0]['book'];
  /** Show reading-progress bar on this page */
  readingProgress?: boolean;
}
const {
  title,
  description = 'Long-form essays on place, economy, and environment, with a monthly digest of systems in motion.',
  active,
  ogImage,
  bodyClass = '',
  book,
  readingProgress = false,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://wayward.house';
const cfToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const og = ogImage ?? `/og${Astro.url.pathname.replace(/\/$/, '') || '/index'}.png`;
const fullTitle = title === 'Wayward House' ? title : `${title} · Wayward House`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,400;0,600;0,700;0,800;1,700&family=Barlow:wght@300;400;500;600;700&family=Literata:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap" />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Social -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(og, siteUrl).toString()} />
  <meta property="og:site_name" content="Wayward House" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- Feeds -->
  <link rel="alternate" type="application/rss+xml" title="Wayward House — Essays" href="/rss.xml" />
  <link rel="alternate" type="application/rss+xml" title="System Signals" href="/signals/rss.xml" />

  <!-- Pagefind UI styles (generated at build time; safe to 404 in dev) -->
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" media="all" onerror="this.remove()" />

  {cfToken && (
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={`{"token": "${cfToken}"}`}
    />
  )}
</head>
<body class={`wh-page ${bodyClass}`}>
  {readingProgress && <div class="wh-progress" aria-hidden="true"><div class="wh-progress__bar" id="wh-progress-bar"></div></div>}
  <Header active={active} book={book} />
  <main id="main">
    <slot />
  </main>
  <Footer />

  {readingProgress && (
    <script>
      // Reading-progress bar — tracks scroll within #main.
      const bar = document.getElementById('wh-progress-bar');
      const target = document.getElementById('main');
      if (bar && target) {
        const tick = () => {
          const rect = target.getBoundingClientRect();
          const total = rect.height - window.innerHeight;
          const scrolled = Math.min(Math.max(-rect.top, 0), total);
          const pct = total > 0 ? (scrolled / total) * 100 : 0;
          bar.style.width = `${pct}%`;
        };
        document.addEventListener('scroll', tick, { passive: true });
        window.addEventListener('resize', tick);
        tick();
      }
    </script>
  )}
</body>
</html>
