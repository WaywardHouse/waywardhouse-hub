---
import { navItems, type NavKey } from '@lib/tokens';
interface Props {
  active?: NavKey;
  /** Set when this page is rendered inside a book sub-route — adds the second-tier nav. */
  book?: {
    title: string;        // "Computational Geography"
    chapter: string;      // "Ch. 3 · Earth systems"
    backHref?: string;    // defaults to /library/
    contentsHref?: string;
    pdfHref?: string;
    repoHref?: string;
    activeTab?: 'contents' | 'reading' | 'pdf' | 'repo';
  };
}
const { active, book } = Astro.props;
---
<header class="wh-hdr">
  <div class="wh-hdr__inner">
    <a class="wh-brand" href="/">
      <span>Wayward</span><span class="wh-brand__dot">·</span><span>House</span>
    </a>
    <nav class="wh-nav">
      {navItems.map((it) => (
        <a class={active === it.key ? 'is-active' : ''} href={it.href}>{it.label}</a>
      ))}
    </nav>
    <div class="wh-hdr__actions">
      <button class="wh-search" type="button" data-pagefind-trigger aria-label="Search">
        <span class="wh-search__icon">⌕</span>
        <span>Search</span>
        <span class="wh-search__hint">/</span>
      </button>
      <a class="wh-sub" href="/signals/#subscribe">Subscribe</a>
    </div>
  </div>
  {book && (
    <div class="wh-hdr__book">
      <div class="wh-hdr__book-inner">
        <a class="wh-hdr__book-back" href={book.backHref ?? '/library/'}>← Library</a>
        <div class="wh-hdr__book-title">
          <span class="wh-hdr__book-kicker">Book · {book.title}</span>
          <span class="wh-hdr__book-name">{book.chapter}</span>
        </div>
        <div class="wh-hdr__book-nav">
          <a href={book.contentsHref ?? '#contents'} class={book.activeTab === 'contents' ? 'is-active' : ''}>Contents</a>
          <a href="#" class={book.activeTab === 'reading' ? 'is-active' : ''}>Reading</a>
          {book.pdfHref && <a href={book.pdfHref} class={book.activeTab === 'pdf' ? 'is-active' : ''}>PDF</a>}
          {book.repoHref && <a href={book.repoHref} class={book.activeTab === 'repo' ? 'is-active' : ''}>Repo</a>}
        </div>
      </div>
    </div>
  )}
</header>

<!-- Pagefind modal — built lazily; the script is loaded only when the trigger fires. -->
<div id="pagefind-modal" hidden></div>

<script is:inline>
  // Lazy-load Pagefind UI on first activation. Pagefind is generated by
  // `pagefind --site dist` in the build script; the bundle lives at /pagefind/.
  const triggers = document.querySelectorAll('[data-pagefind-trigger]');
  let booted = false;
  async function boot() {
    if (booted) return;
    booted = true;
    await import('/pagefind/pagefind-ui.js');
    const PagefindUI = window.PagefindUI;
    const modal = document.getElementById('pagefind-modal');
    modal.removeAttribute('hidden');
    modal.innerHTML = '<div class="wh-search-modal"><button class="wh-search-modal__close" aria-label="Close">×</button><div class="wh-search-modal__inner"><div id="pagefind-mount"></div></div></div>';
    new PagefindUI({ element: '#pagefind-mount', showImages: false, resetStyles: false });
    modal.querySelector('.wh-search-modal__close').addEventListener('click', close);
    modal.addEventListener('click', (e) => { if (e.target === modal.firstElementChild) close(); });
    setTimeout(() => { const i = modal.querySelector('input'); if (i) i.focus(); }, 50);
  }
  function close() { const m = document.getElementById('pagefind-modal'); if (m) m.setAttribute('hidden', ''); }
  triggers.forEach((t) => t.addEventListener('click', boot));
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && !(e.target instanceof HTMLInputElement)) { e.preventDefault(); boot(); }
    if (e.key === 'Escape') close();
  });
</script>
